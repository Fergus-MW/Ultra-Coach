# Copy to .env and fill in. Never commit the filled version.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
XAI_API_KEY=
XAI_MODEL=grok-4-fast-reasoning
ZEP_API_KEY=
TAVILY_API_KEY=

# Shared secret the ElevenLabs agent sends back on tool and custom-LLM calls.
TOOL_SECRET=

# Comma separated, e.g. https://ultra-coach.60x.ai
ALLOWED_ORIGINS=*
CHECKIN_HOUR_UTC=7
SCHEDULER_ENABLED=true
