# Copy to .env and fill in. Never commit the filled version.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
XAI_API_KEY=
XAI_MODEL=grok-4-fast-reasoning
ZEP_API_KEY=
TAVILY_API_KEY=

# Our self-hosted Open Wearables deployment, for Fitbit and the rest. Unset means no
# connect flow and no wearable data: the webhook refuses everything and the coach
# simply has no numbers.
WEARABLES_URL=
WEARABLES_API_KEY=
WEARABLES_WEBHOOK_SECRET=

# Postgres holding call history and wearable data. Unset means memory only, so a
# restart forgets who was called and which device is connected.
DATABASE_URL=

# Where the runner is sent back to after connecting a device.
PWA_URL=

# Shared secret the ElevenLabs agent sends back on tool and custom-LLM calls.
# Unset means the tool, custom-LLM and ring endpoints refuse every request.
TOOL_SECRET=

# Signs device tokens. Unset means tokens are invalidated on every restart.
SESSION_SECRET=

# Comma separated, e.g. https://ultra-coach.60x.ai. Empty means same-origin only.
ALLOWED_ORIGINS=
CHECKIN_HOUR_UTC=7
SCHEDULER_ENABLED=true
